# Quantum chemistry workload, bare metal: two-electron integral derivatives
# through libcint on the RISC-V target.
#
# Upstream is compiled unmodified from ../../qchem-libcint.  cmake is not
# used: cross-compiling a bare-metal target through it costs more than
# compiling the source list directly, and the list is taken straight from
# upstream's CMakeLists.txt (the base cintSrc set).  The two headers cmake
# would produce with configure_file are generated by ./mkheaders.sh into gen/.
#
#   make                       build the default (small) size
#   make run SIZE=tiny         functional check on spike
#   make BM_ENV=linux run      the same, as a static Linux binary under qemu
#
# Deliberately NOT built: src/polyfits.c, src/sr_rys_polyfits.c (upstream's
# WITH_POLYNOMIAL_FIT), src/g2e_f12.c, src/stg_roots.c (WITH_F12), and the
# 4c1e files.  They are off by default upstream, the two-electron integral
# workload never reaches them, and they are the only users of the nine large
# Rys-root data tables (123 MB, nearly the whole vendored tree).
#
# Note what that does NOT include: src/rys_roots.c IS built, and it
# #includes src/roots_for_x0.dat (76 KB).  That one table is required --
# trimming the tree with a blanket "*.dat" leaves the port unbuildable.

.DEFAULT_GOAL := all

BM_NAME  = libcint
UPSTREAM = ../../qchem-libcint/libcint

UPSTREAM_SRC = \
  c2f cart2sph cint1e cint2e cint_bas \
  fblas g1e g2e misc optimizer \
  fmt rys_wheeler eigh rys_roots find_roots \
  cint2c2e g2c2e cint3c2e g3c2e \
  cint3c1e g3c1e breit \
  cint1e_a cint3c1e_a \
  cint1e_grids g1e_grids

UPSTREAM_AUTOCODE = \
  breit1 dkb gaunt1 grad1 grad2 hess \
  int3c1e int3c2e intor1 intor2 intor3 intor4 \
  deriv3 int1e_grids1 deriv4 lresc

BM_SRCS = $(addprefix $(UPSTREAM)/src/,$(addsuffix .c,$(UPSTREAM_SRC))) \
          $(addprefix $(UPSTREAM)/src/autocode/,$(addsuffix .c,$(UPSTREAM_AUTOCODE))) \
          libcint-driver.c

# expl/erfl/erfcl: newlib does not provide them, glibc does.  See
# bm_longdouble.c -- and note it counts its calls, and the count is always 0.
BM_SRCS_BM = bm_longdouble.c

# Angular momentum drives the cost far harder than centre count, so the
# ladder turns d shells on before adding a third centre.  Measured on spike:
#   tiny   2 centres, s+p       256 quartets      23 M instructions
#   small  2 centres, s+p+d    1296 quartets     154 M
#   ref    3 centres, s+p+d    6561 quartets     779 M
SIZE ?= small
ifeq ($(SIZE),tiny)
  NATM = 2
  WITH_D = 0
else ifeq ($(SIZE),small)
  NATM = 2
  WITH_D = 1
else ifeq ($(SIZE),ref)
  NATM = 3
  WITH_D = 1
else
  $(error SIZE must be one of tiny, small, ref)
endif

# Tag the build with the values, not just the size name: changing what a
# size means (as the ladder above did once) must force a relink.
BM_CONFIG_TAG = $(SIZE)-$(NATM)-$(WITH_D)

BM_CFLAGS = -std=gnu99 -I gen -I $(UPSTREAM)/include -I $(UPSTREAM)/src \
            -DBM_NATM=$(NATM) -DBM_WITH_D=$(WITH_D)

include ../common/bm.mk

gen/cint.h gen/cint_config.h: mkheaders.sh $(UPSTREAM)/CMakeLists.txt
	./mkheaders.sh $(UPSTREAM) gen

$(BM_OUT): gen/cint.h gen/cint_config.h

all: $(BM_OUT)

# How to drive this port; `make run` uses it for whichever
# environment the build selected (spike for baremetal, qemu for linux).
BM_RUN_ARGS = 
