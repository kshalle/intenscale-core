+    val magGeOne_reg       = Reg(next = magGeOne) 
+    val rawIn_reg          = Reg(next = rawIn) 
+    val unroundedInt_reg   = Reg(next = unroundedInt)   
+    val signedOut_reg      = Reg(next = io.signedOut)     
+    val roundIncr_reg      = Reg(next = roundIncr)  
+    val common_inexact_reg = Reg(next = common_inexact)
+    val roundedInt_reg     = Reg(next = roundedInt)      
