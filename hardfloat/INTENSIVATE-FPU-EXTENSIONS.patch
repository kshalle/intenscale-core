+    io.rawOut.isZero := isZero_Z_reg
+    io.rawOut.sign   := sign_Z_reg
+    io.rawOut.sExp   := sExp_Z_reg
+    io.rawOut.sig    := sigx_wire<<1 | notZeroRem_Z_reg
+
