+    DivSqrtRecFNToRaw_small4(expWidth: Int, sigWidth: Int, options: Int)
+    extends Module with RequireAsyncReset
+{
+    val io = IO(new Bundle {
+        /*--------------------------------------------------------------------
+        *--------------------------------------------------------------------*/
+        val inReady        = Output(Bool())
+        val inValid        = Input(Bool())
