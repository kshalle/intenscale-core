+    /*------------------------------------------------------------------------
+    *------------------------------------------------------------------------*/
+    val cycleNum_reg       = RegInit(0.U((log2Up(sigWidth + 3)).W))
+    val newBit             = Wire(UInt(2.W))
+    val sqrtOp_Z_reg       = Reg(Bool())
+    val majorExc_Z_reg     = RegInit( false.B)
