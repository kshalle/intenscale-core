+    val new_rem = Mux(newBit === 3.U, trialRem2.asUInt, 0.U) |
+                  Mux(newBit === 2.U, trialRem1.asUInt, 0.U) |
+                  Mux(newBit === 1.U, trialRem.asUInt, 0.U)  |
+                  Mux(newBit === 0.U, ex1_rem, 0.U)
+
