+    //------------------------------------------------------------------------
+    val invalidExc = rawIn_reg.isNaN || rawIn_reg.isInf
+    val overflow = !invalidExc && common_overflow
+    val inexact  = !invalidExc && !common_overflow && common_inexact_reg
+
+    val excSign = !rawIn_reg.isNaN && rawIn_reg.sign
+    val excOut =
+        Mux((signedOut_reg === excSign),
+            UInt(BigInt(1)<<(intWidth - 1)),
+            UInt(0)
+        ) |
+        Mux(!excSign, UInt((BigInt(1)<<(intWidth - 1)) - 1), UInt(0))
+
+    io.out := Mux(invalidExc || common_overflow, excOut, roundedInt_reg)
+    io.intExceptionFlags := Cat(invalidExc, overflow, inexact)
+}
