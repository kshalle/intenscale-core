+            (posExp_reg >= UInt(intWidth)) ||
+                Mux(signedOut_reg, 
+                    Mux(rawIn_reg.sign,
+                        magGeOne_atOverflowEdge &&
+                            (unroundedInt_reg(intWidth - 2, 0).orR || roundIncr_reg),
+                        magGeOne_atOverflowEdge ||
+                            ((posExp_reg === UInt(intWidth - 2)) && roundCarryBut2)
+                    ),
+                    rawIn_reg.sign ||
+                        (magGeOne_atOverflowEdge &&
+                             unroundedInt_reg(intWidth - 2) && roundCarryBut2)
+                ),
+            !signedOut_reg && rawIn_reg.sign && roundIncr_reg
+        )
