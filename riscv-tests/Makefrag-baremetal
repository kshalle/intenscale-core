XLEN ?= 64

default: all

src_dir = .
common_dir = ../common

#--------------------------------------------------------------------
# Build rules
#--------------------------------------------------------------------
#-march=rv64imafd
#-falign-labels=4 -freorder-blocks-algorithm=simple

RISCV_PREFIX ?= riscv$(XLEN)-unknown-elf-
RISCV_GCC ?= $(RISCV_PREFIX)gcc
# Total hart count the multi-threaded benchmarks (mt-*) divide work across --
# baked in at compile time (see crt.S), so it must match whatever RTL config
# the resulting binaries will actually run against. Rebuild with e.g.
# NHARTS=32 before testing a config with a different hart count.
NHARTS ?= 16
RISCV_GCC_OPTS ?= -DPREALLOCATE=1 -DNHARTS=$(NHARTS) -mcmodel=medany -static -std=gnu99 -O2 -ffast-math -fno-common -fno-builtin-printf -march=rv64imafdc
#-falign-labels=4 -mbranch-cost=10
RISCV_LINK ?= $(RISCV_GCC) -T $(common_dir)/test.ld $(incs)
RISCV_LINK_OPTS ?= -static -nostdlib -nostartfiles -lm -lgcc -T $(common_dir)/test.ld
RISCV_OBJDUMP ?= $(RISCV_PREFIX)objdump -D ##--disassemble-all --disassemble-zeroes --section=.text --section=.text.startup --section=.data
RISCV_SIM ?= spike --isa=rv$(XLEN)gc

incs += -I$(src_dir)/../env -I$(common_dir) -I$(common_dir)/ck
objs :=

define compile_template
$(1).riscv: $(wildcard $(src_dir)/$(1)/*) $(wildcard $(common_dir)/*)
	$$(RISCV_GCC) $$(incs) $$(RISCV_GCC_OPTS) $$(EXTRA_CFLAGS) -o $$@ $(wildcard $(src_dir)/$(1)/*.c) $(wildcard $(common_dir)/*.c) $(wildcard $(common_dir)/*.S) $$(RISCV_LINK_OPTS)
endef

$(foreach bmark,$(tests),$(eval $(call compile_template,$(bmark))))

#---------------------------
# Build and run on verilator
tests_riscv_bin  = $(addsuffix .riscv,  $(tests))
tests_riscv_dump = $(addsuffix .riscv.dump, $(tests))
tests_riscv_out  = $(addsuffix .riscv.out,  $(tests))

$(tests_riscv_dump): %.riscv.dump: %.riscv
	$(RISCV_OBJDUMP) $< > $@

$(tests_riscv_out): %.riscv.out: %.riscv
	$(RISCV_SIM) $< > $@

riscv: $(tests_riscv_dump)
run: $(tests_riscv_out)

junk += $(tests_riscv_bin) $(tests_riscv_dump) $(tests_riscv_hex) $(tests_riscv_out)

#------------------------------------------------------------
# Default

all: riscv

#------------------------------------------------------------
# Install

date_suffix = $(shell date +%Y-%m-%d_%H-%M)
install_dir = $(instbasedir)/$(instname)-$(date_suffix)
latest_install = $(shell ls -1 -d $(instbasedir)/$(instname)* | tail -n 1)

install:
	mkdir $(install_dir)
	cp -r $(tests_riscv_bin) $(tests_riscv_dump) $(install_dir)

install-link:
	rm -rf $(instbasedir)/$(instname)
	ln -s $(latest_install) $(instbasedir)/$(instname)

#------------------------------------------------------------
# Clean up

clean:
	rm -rf $(objs) $(junk)
